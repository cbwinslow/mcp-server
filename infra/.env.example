# Core networking/DNS
PUBLIC_HOST=192.168.4.117

# Neo4j
NEO4J_PASSWORD=change-me

# Postgres (via Supabase or external)
POSTGRES_HOST=supabase-db
POSTGRES_DB=mcp
POSTGRES_USER=mcp_app
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:5432/${POSTGRES_DB}

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# LlamaIndex / Embeddings
EMBEDDING_MODEL=text-embedding-3-small

# Langfuse (optional, compose.ai.yml)
LANGFUSE_DATABASE_URL=postgres://langfuse:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:5432/langfuse
LANGFUSE_NEXTAUTH_SECRET=change-me-long
LANGFUSE_PUBLIC_URL=https://${PUBLIC_HOST}/langfuse
LANGFUSE_SALT=change-me-long
LANGFUSE_ENCRYPTION_KEY=change-me-32-bytes

