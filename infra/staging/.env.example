# Staging
API_BASE_URL=https://api-staging.cloudcurio.cc
WEB_BASE_URL=https://mcp-staging.cloudcurio.cc

GOTRUE_JWT_SECRET=

DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:5432/mcp
VECTOR_DIM=1536

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

NEBULA_ADDR=127.0.0.1:9669
NEBULA_USER=root
NEBULA_PASSWORD=

TERMINUSDB_ENDPOINT=http://127.0.0.1:6363
TERMINUSDB_DB=mcp
TERMINUSDB_TOKEN=

CHAT_MODEL=localai/llama3
LOCALAI_BASE_URL=http://127.0.0.1:8080

# Cloudflare Tunnel (optional)
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare API for server-side KV reads
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_TITLE=mcp-secrets
CF_KV_ENV_PREFIX=staging

PYTHONUNBUFFERED=1
LOG_LEVEL=info
