# Core URLs
API_BASE_URL=https://api.cloudcurio.cc
WEB_BASE_URL=https://mcp.cloudcurio.cc

# Auth (Supabase GoTrue compatible JWT secret)
GOTRUE_JWT_SECRET=

# Postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:5432/mcp

# pgvector
VECTOR_DIM=1536

# Graph backends (external by default)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

NEBULA_ADDR=127.0.0.1:9669
NEBULA_USER=root
NEBULA_PASSWORD=

TERMINUSDB_ENDPOINT=http://127.0.0.1:6363
TERMINUSDB_DB=mcp
TERMINUSDB_TOKEN=

# Chat / LLM
CHAT_MODEL=localai/llama3
LOCALAI_BASE_URL=http://127.0.0.1:8080

# Cloudflare Tunnel (optional)
CLOUDFLARE_TUNNEL_TOKEN=

# Misc
PYTHONUNBUFFERED=1
LOG_LEVEL=info
