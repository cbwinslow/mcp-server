[Unit]
Description=MCP Platform (Docker Compose)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory={{ compose_dir }}
RemainAfterExit=yes
ExecStart=/usr/bin/docker compose -f {{ compose_file | default('docker-compose.prod.yml') }} up -d --build
ExecStop=/usr/bin/docker compose -f {{ compose_file | default('docker-compose.prod.yml') }} down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target

